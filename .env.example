# Server only. Never prefix these with NEXT_PUBLIC_.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_REALTIME_MODEL=gpt-realtime-2.1-mini
OPENAI_REALTIME_VOICE=marin
# Use only synthetic data in demo mode. Live mode uses the current date.
GIFTGUARD_DEMO=true
# Set a strong password before using real data or sharing the server.
GIFTGUARD_PASSWORD=
GIFTGUARD_DB=data/giftguard.sqlite
# Optional. Signs the staff session cookie; at least 32 characters. When unset, a generated secret is kept beside the database so restarts do not sign staff out.
GIFTGUARD_SESSION_SECRET=
